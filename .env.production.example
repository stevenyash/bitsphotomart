# ============================================
# BITS PHOTO MART - PRODUCTION ENV TEMPLATE
# Copy this to .env.production and fill in values
# ============================================

# Database Connection (MariaDB)
DATABASE_HOST=your-db-host
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=bitsphotomart
DATABASE_PORT=3306

# NextAuth - PRODUCTION
NEXTAUTH_URL="https://bpm.yourdomain.com"
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Cookie domain must match your production domain (e.g., ".yourdomain.com")
NEXTAUTH_COOKIE_DOMAIN=".yourdomain.com"

# Application - PRODUCTION
NEXT_PUBLIC_APP_URL="https://bitsphotomart.co.ke"
NEXT_PUBLIC_APP_NAME="Bits Photo Mart"

# ============================================
# M-Pesa Configuration (PRODUCTION - LIVE)
# Get from https://developer.safaricom.co.ke
# ============================================
MPESA_ENVIRONMENT="production"
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_BUSINESS_SHORTCODE=your-business-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL="https://bitsphotomart.co.ke/api/mpesa/stk-callback"
MPESA_INITIATOR_NAME=your-initiator-name
MPESA_INITIATOR_PASSWORD=your-initiator-password
MPESA_SECURITY_CREDENTIAL=your-security-credential

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_SENDER=noreply@bitsphotomart.co.ke
EMAIL_SENDERNAME="Bits Photo Mart"
EMAIL_SEND=true

# ============================================
# MobileSasa SMS
# ============================================
MOBILESASA_SENDER_ID=BITSPhotoMart
MOBILESASA_AUTH_TOKEN=your-auth-token

# ============================================
# STRIPE CONFIGURATION (PRODUCTION - LIVE)
# Get from https://dashboard.stripe.com/live/apikeys
# ============================================
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ============================================
# PAYPAL CONFIGURATION (PRODUCTION - LIVE)
# Get from https://developer.paypal.com/
# ============================================
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=live

# ============================================
# JWT AUTHENTICATION - PRODUCTION
# Generate secure secrets with: openssl rand -base64 32
# ============================================
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=your-cookie-secret

# ============================================
# AWS S3 Configuration - PRODUCTION
# Create bucket in AWS Console
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=af-south-1
AWS_S3_BUCKET_NAME=bitsphotomart-media
AWS_S3_BUCKET_PREFIX=production/
AWS_S3_MAX_FILE_SIZE=104857600
AWS_S3_SIGNED_URL_EXPIRY=3600
AWS_S3_PUBLIC_URL_EXPIRY=604800

# CloudFront CDN
AWS_CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.cloudfront.net
AWS_CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=10485760
MAX_FILES_PER_UPLOAD=10
UPLOAD_PATH=./uploads
TEMP_UPLOAD_PATH=./uploads/temp

ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/mov,video/avi,video/webm,video/quicktime
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# ============================================
# WATERMARK CONFIGURATION
# ============================================
WATERMARK_ENABLED=true
WATERMARK_TEXT="© Bits Photo Mart"
WATERMARK_OPACITY=0.7
WATERMARK_POSITION=southeast
WATERMARK_FONT_SIZE=48
WATERMARK_COLOR=#FFFFFF

# ============================================
# THUMBNAIL CONFIGURATION
# ============================================
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=200
THUMBNAIL_QUALITY=80
THUMBNAIL_FORMAT=jpeg

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_SECRET=your-session-secret
SESSION_MAX_AGE=86400000

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=https://bitsphotomart.co.ke,https://www.bitsphotomart.co.ke
CORS_CREDENTIALS=true

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=warn
LOG_TO_FILE=true
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=10

# ============================================
# MONITORING
# ============================================
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30000
